{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":disableDependencyDashboard",
    ":semanticCommitTypeAll(build)",
  ],

  // General settings
  "baseBranchPatterns": ["main"],
  "branchConcurrentLimit": 5,
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  // "not-pending" waits for branch checks to finish before opening the PR.
  // There is no CI here yet (#15), so nothing ever reports and every PR would
  // sit out the ~25h prNotPendingHours fallback. internalChecksFilter already
  // enforces minimumReleaseAge before the branch is pushed, so the cooldown
  // does not depend on this.
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",

  // Refresh uv.lock so transitive pins move too. The default schedule is
  // "before 4am on monday", which leaves transitive security fixes up to a
  // week behind every other update.
  "lockFileMaintenance": { "enabled": true, "schedule": [] },

  // Pin Actions by digest and rewrite the trailing version comment on every
  // bump, so the pinned ratio starts at 100% once workflows exist (#15).
  "github-actions": { "pinDigests": true },

  "vulnerabilityAlerts": { "labels": ["dependencies", "security"] },

  // Package- or manager-specific rules
  "packageRules": [
    {
      "groupName": "auto-merge non-major dependencies",
      "groupSlug": "all-non-major",
      "matchUpdateTypes": ["!major"],
      "automerge": true,
    },
    {
      // pep621 names depTypes after the pyproject table they came from, so the
      // dev group is "dependency-groups" (PEP 735). npm's "devDependencies"
      // matches nothing in a Python repo and fails silently.
      "groupName": "auto-merge developer dependencies",
      "groupSlug": "dev-dependencies",
      "matchDepTypes": ["dependency-groups"],
      "automerge": true,
    },

    {
      // uv reads pyproject.toml via the pep621 manager. There is no
      // requirements.txt here, so pip_requirements matched nothing.
      "groupName": "group PyTest package updates together",
      "groupSlug": "pytest",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["/^pytest/"],
    },
  ],

}
